# Copy this file to .env and fill it in. .env is never put into git.
# Without SMTP_USER and SMTP_PASSWORD the codes are printed in the terminal.

# Gmail: turn on 2-step verification for the account, then create an app
# password at https://myaccount.google.com/apppasswords and paste it here.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=yourname@gmail.com
SMTP_PASSWORD=
MAIL_FROM=

# Signs the login cookie. Any long random text, different on every server.
CAMPUS_SECRET=

# Reads ticket screenshots with Claude. Create a key at
# https://platform.claude.com/settings/keys (it costs about one cent per
# screenshot with Claude Opus). Without it the screenshot button is simply not shown.
ANTHROPIC_API_KEY=
