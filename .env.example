# Local development
# Generate this with: python -c "import secrets; print(secrets.token_hex(32))"
CAMPUS_SECRET=

# Set 1 ONLY on a private development machine. Leave 0 on a public deployment.
CAMPUS_SECURITY_DEMO=0

# Gmail requires an app password. No real credentials belong in this file.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
