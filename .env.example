# Local development
# Generate this with: python -c "import secrets; print(secrets.token_hex(32))"
CAMPUS_SECRET=

# Set 1 ONLY on a private development machine. Leave 0 on a public deployment.
CAMPUS_SECURITY_DEMO=0

# In private demo mode only, missing SMTP prints codes to the terminal.
# Gmail requires an app password. No real credentials belong in this file.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Reads ticket screenshots with Claude. Create a key at
# https://platform.claude.com/settings/keys (it costs about one cent per
# screenshot with Claude Opus). Without it the screenshot button is simply not shown.
ANTHROPIC_API_KEY=

# Push notifications. Make a key pair with:  python -m app.push keys
# and paste its lines here. Without them notifications are switched off.
# VAPID_SUBJECT is optional, it falls back to the address the app sends from.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
